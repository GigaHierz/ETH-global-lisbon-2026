#!/usr/bin/env bash
# Backstop for pushes made outside Claude Code.
set -uo pipefail
ROOT=$(git rev-parse --show-toplevel)
BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "${OVERRIDE_GATE:-0}" = "1" ]; then
  mkdir -p "$ROOT/.git/hackkit"
  printf '%s\t%s\n' "$(date -u +%FT%TZ)" "$BRANCH" >> "$ROOT/.git/hackkit/override.log"
  echo "Quality gate overridden."
  exit 0
fi

if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo "Refusing to push directly to $BRANCH. Use a feature branch." >&2
  exit 1
fi

bash "$ROOT/scripts/quality-gate.sh" || {
  echo "" >&2
  echo "Push blocked by the quality gate. To bypass deliberately:" >&2
  echo "  OVERRIDE_GATE=1 git push" >&2
  exit 1
}
