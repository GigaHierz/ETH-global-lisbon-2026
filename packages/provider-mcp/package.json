{
  "name": "@agentrouter/provider-mcp",
  "version": "0.1.0",
  "description": "MCP server that provisions an AgentRouter inference provider on Hedera Testnet end-to-end (account, stake, HCS-14 registration, endpoint attach, discovery verification).",
  "type": "module",
  "bin": {
    "agentrouter-provider-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "inspect": "npx -y @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "dependencies": {
    "@agentrouter/shared": "workspace:*",
    "@hiero-ledger/sdk": "2.85.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
