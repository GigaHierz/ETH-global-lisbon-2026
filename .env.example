# ── AgentRouter environment ─────────────────────────────────────────────
# Quickstart: `pnpm gen-wallets` writes a fresh .env with all keys generated.

# MOCK_MODE=true → no chain, no RPC, in-memory payments/registry/stakes.
# The full demo works in mock mode with zero funding. Flip to false for
# real x402 payments on Base Sepolia.
MOCK_MODE=true

# Groq API key — get one free at https://console.groq.com/keys
# Leave empty for canned responses (demo still works end-to-end).
GROQ_API_KEY=

# provider3 advertises llama-3.3-70b-versatile but secretly serves
# llama-3.1-8b-instant when true. The verifier catches this. Keep true for demo.
CHEAT_MODE=true

# ── wallets (generate with `pnpm gen-wallets`, or paste your own) ───────
PROVIDER1_PK=0x...
PROVIDER2_PK=0x...
PROVIDER3_PK=0x...
AGENT_PK=0x...      # real mode: fund with Base Sepolia ETH + USDC
VERIFIER_PK=0x...   # real mode: fund with Base Sepolia ETH + USDC (pays audit calls, sends slash txs)
EXCHANGE_PK=0x...   # real mode: fund with Base Sepolia ETH + USDC (pays providers)

# ── real-mode funding ───────────────────────────────────────────────────
# Base Sepolia ETH (gas):  https://portal.cdp.coinbase.com/products/faucet
#                     or:  https://www.alchemy.com/faucets/base-sepolia
# Testnet USDC:            https://faucet.circle.com  (select Base Sepolia)

# ── optional overrides ──────────────────────────────────────────────────
# RPC_URL=https://sepolia.base.org
# FACILITATOR_URL=https://x402.org/facilitator
# EXCHANGE_PORT=4100
# PROVIDER_URLS=http://localhost:4021,http://localhost:4022,http://localhost:4023
# VERIFY_INTERVAL_MS=15000
# SIMILARITY_THRESHOLD=0.35
# SLASH_USD=25
# AGENT_MODEL=llama-3.3-70b-versatile
# AGENT_MOCK_BALANCE_USD=1.00
# NEXT_PUBLIC_EXCHANGE_URL=http://localhost:4100
