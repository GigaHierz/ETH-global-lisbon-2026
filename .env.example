# ── AgentRouter environment ─────────────────────────────────────────────
# Everything on-chain runs on Hedera Testnet — payments, identity, staking, audit.

# MOCK_MODE=true → no chain, no RPC, in-memory payments/registry/stakes.
# The full demo works in mock mode with zero funding. Flip to false for
# real x402 HBAR settlement on hedera:testnet.
MOCK_MODE=true

# Groq API key — get one free at https://console.groq.com/keys
# Leave empty for canned responses (demo still works end-to-end).
GROQ_API_KEY=

# provider3 advertises llama-3.3-70b-versatile but secretly serves
# llama-3.1-8b-instant when true. The verifier catches this. Keep true for demo.
CHEAT_MODE=true

# ── Hedera accounts (real mode) ─────────────────────────────────────────
# 1. Create a testnet operator at https://portal.hedera.com and paste it here.
# 2. `pnpm setup-hedera` creates + funds all role accounts from the operator
#    and writes HEDERA_<ROLE>_ID / HEDERA_<ROLE>_KEY (+ HEDERA_ESCROW_ID) below.
#    Roles: AGENT, EXCHANGE, PROVIDER1-4, PROVIDER (generic), VERIFIER, ESCROW,
#    AUDITOR (second signer on the multi-sig HTS bond wipe).
# 3. `pnpm setup-hts` creates the HTS ReputationBond token (ARBOND) + grants each
#    provider its bond, writing `bondToken` into deployments.json (not .env).
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=

# ── optional overrides ──────────────────────────────────────────────────
# FACILITATOR_URL=https://x402.org/facilitator   # else the built-in ladder is used
# EXCHANGE_PORT=4100
# EXCHANGE_ASK_HBAR=0.12          # flat x402 ask the agent pays the exchange per request
# AGENT_BUDGET_HBAR=2             # agent stops buying once cumulative spend hits this
# AGENT_PORT=4200                 # standalone web-agent server
# PROVIDER_URLS=http://localhost:4021,http://localhost:4022,http://localhost:4023

# ── hosting (Railway etc.) ──────────────────────────────────────────────
# When a provider runs as its own deployment, set these so a remote exchange
# can reach it. Locally, leave both unset (defaults to localhost:<profile port>).
# PORT is injected by Railway automatically — the provider binds to it.
# PROVIDER_PROFILE selects the personality when you can't pass --profile.
# PROVIDER_PROFILE=provider4
# PROVIDER_PUBLIC_URL=https://your-provider.up.railway.app

# ── list your own compute (custom provider) ─────────────────────────────
# Run `pnpm provider` (== --profile custom) to list your own inference,
# no code edits. Uses the HEDERA_PROVIDER_ID/KEY account (from `pnpm
# setup-hedera`, or paste your own testnet account). Advertise = serve.
# PROVIDER_NAME=Acme Inference
# PROVIDER_MODEL=llama-3.3-70b-versatile
# PROVIDER_PRICE_HBAR=0.10
# PROVIDER_PORT=4025
# HEDERA_PROVIDER_ID=0.0.xxxxxx
# HEDERA_PROVIDER_KEY=0x...
# VERIFY_INTERVAL_MS=15000
# SIMILARITY_THRESHOLD=0.35
# STAKE_HBAR=50
# SLASH_HBAR=25
# BOND_AMOUNT=100                 # HTS ReputationBond (ARBOND) granted per provider
# HTS_BOND_TOKEN=0.0.xxxxxx       # override; else read from deployments.json (pnpm setup-hts)
# AGENT_MODEL=llama-3.3-70b-versatile
# AGENT_MOCK_BALANCE_HBAR=10
# NEXT_PUBLIC_EXCHANGE_URL=http://localhost:4100

# exchange taker fee (basis points; 1000 = 10%). Provider keeps its full ask.
EXCHANGE_FEE_BPS=1000
# refund settled agent payments if the provider call fails afterwards
REFUND_ON_FAILURE=true

# ── 0G Compute (default supply backend for bring-your-own providers) ──────
# Key from https://pc.0g.ai (fund with 0G testnet tokens). Without it, 0G-backed
# providers serve canned fallback responses (demo-safe).
ZEROG_API_KEY=
# Compute backend for `--profile custom` providers: 0g (default) | groq | canned.
# The named demo profiles pin their own backend (p1-p3 groq, p4 0g).
PROVIDER_BACKEND=0g
