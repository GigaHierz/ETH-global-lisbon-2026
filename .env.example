# ── AgentRouter environment ─────────────────────────────────────────────
# Everything on-chain runs on Hedera Testnet — payments, identity, staking, audit.
# Grouped by the service that reads each variable. Everything commented out is
# optional and shows its built-in default.

# MOCK_MODE=true → no chain, no RPC, in-memory payments/registry/stakes.
# The full demo works in mock mode with zero funding and zero faucet trips.
# Flip to false for real x402 settlement on hedera:testnet.
MOCK_MODE=true

# Groq API key — get one free at https://console.groq.com/keys
# Leave empty for canned responses (demo still works end-to-end).
GROQ_API_KEY=

# provider3 advertises llama-3.3-70b-versatile but secretly serves
# llama-3.1-8b-instant when true. The verifier catches this. Keep true for demo.
CHEAT_MODE=true

# ── settlement asset ────────────────────────────────────────────────────
# Which asset per-request payments settle in. Read by every service, so keep it
# consistent across all of them — a provider quoting a different asset than the
# payer signs will fail settlement.
#
#   usdc (default) — HTS token 0.0.429274, 6 dp. Needs token association on every
#                    account and testnet USDC from https://faucet.circle.com.
#   hbar           — native HBAR, tinybar amounts. No faucet, fully scriptable;
#                    the zero-external-dependency path for CI and offline demos.
#
# Anything unset, empty, or unrecognised falls back to usdc.
# The quality bond (STAKE_HBAR / SLASH_HBAR) is ALWAYS native HBAR either way.
SETTLEMENT_ASSET=usdc

# ── Hedera accounts (real mode) ─────────────────────────────────────────
# 1. Create a testnet operator at https://portal.hedera.com and paste it here.
# 2. `pnpm setup-hedera` creates + funds all role accounts from the operator,
#    associates each with USDC, and writes HEDERA_<ROLE>_ID / _KEY / _EVM below.
#    Roles: AGENT, EXCHANGE, PROVIDER1-4, PROVIDER (generic), VERIFIER, ESCROW,
#    AUDITOR (second signer on the multi-sig HTS bond wipe).
# 3. For USDC: fund the operator at https://faucet.circle.com (Hedera Testnet →
#    your operator id, ~20 USDC/2h), then re-run `pnpm setup-hedera` to fan it
#    out to the paying roles (AGENT, EXCHANGE, VERIFIER).
# 4. `pnpm setup-hts` creates the HTS ReputationBond token (ARBOND) + grants each
#    provider its bond, writing `bondToken` into deployments.json (not .env).
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=

# ── HCS audit topics ────────────────────────────────────────────────────
# `pnpm setup-hcs` mints the three topics and prints their ids. They are read
# from deployments.json by default; set them here to override per environment.
# Prefer these env vars on a hosted deploy — deployments.json is resolved
# relative to the process working directory, which containers don't guarantee.
# HCS_REGISTRY_TOPIC=0.0.xxxxxxx
# HCS_TRADES_TOPIC=0.0.xxxxxxx
# HCS_VERDICTS_TOPIC=0.0.xxxxxxx

# ── exchange ────────────────────────────────────────────────────────────
# EXCHANGE_PORT=4100
# Taker fee in basis points (1000 = 10%). The agent pays provider price + fee;
# the provider always receives its full listed ask, and the fee is exchange revenue.
# Rounded UP in the settlement asset's base units, so the exchange never underquotes.
EXCHANGE_FEE_BPS=1000
# Refund a settled agent payment if the provider call fails afterwards. In real mode
# the x402 middleware usually cancels the payment instead (the agent is never
# charged), so this covers mock mode and settled-then-failed edges.
REFUND_ON_FAILURE=true
# PROVIDER_URLS=http://localhost:4021,http://localhost:4022,http://localhost:4023
# FACILITATOR_URL=https://x402.org/facilitator   # else the built-in ladder is used

# ── agent ───────────────────────────────────────────────────────────────
# EXCHANGE_URL=http://localhost:4100   # where the agent/verifier/demo reach the exchange
# AGENT_PORT=4200                      # standalone web-agent server
# AGENT_PUBLIC_URL=                    # advertised in the HCS-14 registration; set on a host
# AGENT_BUDGET=2                       # stops buying once cumulative spend hits this
# AGENT_MOCK_BALANCE=10                # starting wallet in MOCK_MODE
# AGENT_MODEL=llama-3.3-70b-versatile
# AGENT_BRAIN_MODEL=llama-3.3-70b-versatile   # model used to plan the goal into sub-questions
# AGENT_MAX_QUESTIONS=5

# ── verifier ────────────────────────────────────────────────────────────
# The verifier PAYS providers for its audit replays, so in usdc mode its account
# needs a USDC balance, not just an association — `pnpm setup-hedera` funds it.
# VERIFY_INTERVAL_MS=15000
# SIMILARITY_THRESHOLD=0.35
# REPLAY_TIMEOUT_MS=20000
# STAKE_HBAR=50                   # quality bond posted to escrow — always native HBAR
# SLASH_HBAR=25                   # seized on a proven divergence — always native HBAR

# ── hosting (Railway etc.) ──────────────────────────────────────────────
# When a provider runs as its own deployment, set these so a remote exchange
# can reach it. Locally, leave both unset (defaults to localhost:<profile port>).
# PORT is injected by Railway automatically — the provider binds to it.
# PROVIDER_PROFILE selects the personality when you can't pass --profile.
# PROVIDER_PROFILE=provider4
# PROVIDER_PUBLIC_URL=https://your-provider.up.railway.app

# ── list your own compute (custom provider) ─────────────────────────────
# Run `pnpm provider` (== --profile custom) to list your own inference,
# no code edits. Uses the HEDERA_PROVIDER_ID/KEY account (from `pnpm
# setup-hedera`, or paste your own testnet account). Advertise = serve.
# Guided walkthrough: .claude/skills/onboarding-a-provider/SKILL.md
# As callable tools:   packages/provider-mcp/README.md
# PROVIDER_PUBLIC_URL below is REQUIRED for anything but same-box testing —
# without it the service registers localhost and the exchange shows you down.
# PROVIDER_NAME=Acme Inference
# PROVIDER_MODEL=llama-3.3-70b-versatile
# PROVIDER_PRICE=0.10             # your price per request, in SETTLEMENT_ASSET
# PROVIDER_PORT=4025
# HEDERA_PROVIDER_ID=0.0.xxxxxx
# HEDERA_PROVIDER_KEY=0x...

# ── HTS ReputationBond ──────────────────────────────────────────────────
# Reputation is its OWN HTS token (ARBOND), separate from the settlement asset:
# a provider's bond balance is its on-chain reputation. `pnpm setup-hts` mints
# the token and records its id in deployments.json (not here). On proven fraud
# the verifier freezes the bond, then destroys it with a TokenWipe carrying both
# signatures of the 2-of-2 [verifier, auditor] wipe key — which is why an AUDITOR
# account exists. (TokenWipe is not schedulable, so this is a direct multi-sig
# transaction rather than a Schedule Service one.)
# BOND_AMOUNT=100                 # granted per provider (also the wipe amount)
# HTS_BOND_TOKEN=0.0.xxxxxx       # override; else read from deployments.json

# ── 0G Compute (default supply backend for bring-your-own providers) ────
# Key from https://pc.0g.ai (fund with 0G testnet tokens). Without it, 0G-backed
# providers serve canned fallback responses (demo-safe).
ZEROG_API_KEY=
# Compute backend for `--profile custom` providers: 0g (default) | groq | canned.
# The named demo profiles pin their own backend (p1-p3 groq, p4 0g).
PROVIDER_BACKEND=0g

# ── dashboard (Next.js, build-time) ─────────────────────────────────────
# Both default to the Railway production URLs; ?api=<url> overrides at runtime.
# NEXT_PUBLIC_EXCHANGE_URL=http://localhost:4100
# NEXT_PUBLIC_AGENT_URL=http://localhost:4200
