{
  "name": "agentrouter",
  "private": true,
  "version": "0.1.0",
  "description": "AgentRouter — on-chain OpenRouter: agents buy LLM inference per-request with HBAR via x402 on Hedera, providers registered + reputation-tracked via HCS-14 + Hedera Consensus Service",
  "scripts": {
    "provider1": "tsx --env-file=.env provider/src/index.ts --profile provider1",
    "provider2": "tsx --env-file=.env provider/src/index.ts --profile provider2",
    "provider3": "tsx --env-file=.env provider/src/index.ts --profile provider3",
    "exchange": "tsx --env-file=.env exchange/src/index.ts",
    "verifier": "tsx --env-file=.env verifier/src/index.ts",
    "agent": "tsx --env-file=.env agent/src/index.ts",
    "dashboard": "pnpm --filter @agentrouter/dashboard dev",
    "demo": "tsx --env-file=.env scripts/demo.ts",
    "smoke": "tsx --env-file=.env scripts/smoke-paid-call.ts",
    "setup-hedera": "tsx scripts/setup-hedera-accounts.ts",
    "setup-hcs": "tsx scripts/setup-hcs-topics.ts"
  },
  "dependencies": {
    "@agentrouter/shared": "workspace:*",
    "@hiero-ledger/sdk": "2.85.0",
    "@x402/evm": "^2.19.0",
    "@x402/fetch": "^2.19.0",
    "@x402/hedera": "2.19.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.17.0"
}
